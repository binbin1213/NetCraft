# NetCraft Environment Variables Example

# JWT Secret Key (required) - Generate a strong random key using: openssl rand -hex 32
SECRET_KEY=your_strong_jwt_secret_key_here

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://example.com

# Database URL (should match docker-compose settings)
DATABASE_URL=postgresql://netcraft:CHANGE_ME_STRONG_PASSWORD@localhost:5432/netcraft_db

# AI Service API Keys
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Optional: OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here
