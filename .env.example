# NetCraft Environment Variables Example
# Copy to .env and fill in real values: cp .env.example .env

# JWT Secret Key (REQUIRED - the backend refuses to start without it)
# Generate a strong random key using: openssl rand -hex 32
SECRET_KEY=your_strong_jwt_secret_key_here

# Allowed CORS Origins (comma-separated)
# In production behind nginx the frontend is same-origin, so this mainly
# matters for local development against a separate dev server.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# Database URL (used when running the backend outside Docker)
DATABASE_URL=postgresql://netcraft:CHANGE_ME_STRONG_PASSWORD@localhost:5432/netcraft_db

# PostgreSQL password (used by docker compose for both db and backend)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# AI Service API Keys
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Optional: OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: pin the production backend image to a specific git sha for rollback
# IMAGE_TAG=latest
